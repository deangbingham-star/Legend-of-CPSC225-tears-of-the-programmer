//********************************************
int genRandNum(int x, int y)
{
	//Generate random number between x and Y

	int randNum = x+1 +(rand() % (y)-x);
	cout<<"     min="<<x<<" max="<<y<<endl;
	return randNum;
}

//**********************************************

void shop()
{
	//Manage shop
	cout<<"Welcome to my Shop!\n \nScripts, Memory, RAM, you want it? Its yours my friend! \nAs long as you have enough bits!"
	    " What can I get for you?\n\n(1.Memory +10 (25 bits)\n(2.RAM (200 bits)\n\n(3. Leave :(\n";
	int userSelect =0;
	cin>>userSelect;

	if (userSelect ==1)
	{
		cout<<"\nGood choice, You healed 10 memory\n";

	}
	if (userSelect ==2)
	{
		cout<<"Wow you can actually afford it?! Obtained RAM, You win!\n";
		//hasRAM = true
	}
	if(userSelect ==3)
	{
		cout<<"Goodbye\n";
	}
	else
	{
		cout<<"Sorry I don't speak Italian\n";
	}
}


int fight(int playerHealth,int playerMoney, int bugPOW, int bugWorth)
{
	//fight enemies, win and get their worth or lose and take damage
	int chance= genRandNum(1,2);
	if(chance ==1)
	{
		//Win
		cout<<"\nYOU WIN\n";
		playerMoney = playerMoney + bugWorth;
		cout<<"Your money is now "<<playerMoney<<endl;
	}
	else if (chance ==2)
	{
		//lose
		cout<<"\nYOU LOSE\n";
		playerHealth = playerHealth - bugPOW;
		cout<<"Your health is now "<<playerHealth<<endl;
	}
	return 0;
}

